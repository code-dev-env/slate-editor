{
  "name": "slate-editor",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "build": "electron-builder --win nsis portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "monaco-editor": "^0.52.0"
  },
  "build": {
    "appId": "local.slate.editor",
    "productName": "Slate Editor",
    "asar": false,
    "win": {
      "target": ["nsis", "portable"],
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "build/icon.png",
      "renderer.js",
      "node_modules/monaco-editor/min/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "SlateEditor-Setup.exe"
    },
    "portable": {
      "artifactName": "SlateEditor-Portable-${version}.exe"
    }
  }
}